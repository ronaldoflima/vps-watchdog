# Configuração do cpu-watchdog
# CPU_THRESHOLD: %CPU (base de 1 core, valor do "ps -o %cpu") acima do qual um processo
#                começa a ser contado como "consumindo demais".
CPU_THRESHOLD=80

# SUSTAIN_CHECKS: quantas verificações consecutivas acima do threshold até agir.
# O timer roda a cada 1 minuto, então 5 = 5 minutos sustentados.
SUSTAIN_CHECKS=5

# LIMIT_PERCENT: teto de CPU aplicado via cpulimit quando o processo estoura o limite.
LIMIT_PERCENT=50

# Obs.: comm é truncado em 15 caracteres pelo kernel (ex.: systemd-journald
# aparece como "systemd-journal"), então use o nome como o `ps -o comm` mostra.
# Comandos que NUNCA devem ser throttled/mortos pelas camadas de CPU (1–3),
# mesmo que estourem o limite (infraestrutura essencial do próprio
# sistema/acesso remoto). "claude" é a CLI do Claude Code: sessões interativas
# de agentes de IA que fazem picos longos de CPU legítimos — troque pelos
# seus processos equivalentes ou remova.
WHITELIST_COMM="sshd systemd systemd-journal systemd-logind systemd-udevd systemd-resolve systemd-timesyn earlyoom dbus-daemon cron atop cpulimit cpu-watchdog.sh ps claude"

# Whitelist por LINHA DE COMANDO completa (/proc/<pid>/cmdline), regex ERE.
# Use quando o comm for genérico demais (ex.: "python", "node"), já que
# WHITELIST_COMM isentaria TODOS os processos com aquele nome.
# Vazio = desativado. Vários padrões: separe com "|". Exemplo (um job batch
# em Python e um worker Celery que podem usar CPU cheia por horas):
#   WHITELIST_CMDLINE="python3 -m myapp\\.batch|celery .*worker"
WHITELIST_CMDLINE=""

# --- Alertas via Telegram (opcional) ---
# Preencha para receber notificação a cada ação de throttle. Deixe em branco para
# apenas logar em /var/log/cpu-watchdog.log e no journal (journalctl -u cpu-watchdog).
# Este arquivo passa a conter segredo: mantenha-o root:root com modo 600.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

STATE_DIR="/var/lib/cpu-watchdog"
LOG_FILE="/var/log/cpu-watchdog.log"

# --- Camada 2: uso agregado da máquina (soma de todos os processos) ---
# Cobre o caso de vários processos moderados (ex.: 10 processos a 30% cada)
# que juntos pressionam a VPS mas nenhum sozinho cruza o CPU_THRESHOLD acima.

# AGG_CPU_THRESHOLD_PCT: % da capacidade TOTAL da máquina (nproc * 100).
# Em 4 vCPUs, 75 = 300% de uso somado entre todos os processos.
AGG_CPU_THRESHOLD_PCT=75

# AGG_SUSTAIN_CHECKS: minutos seguidos com uso agregado acima do limite até agir.
AGG_SUSTAIN_CHECKS=5

# Quando dispara: throttle nos AGG_TOP_N processos que mais consomem CPU no
# momento (excluindo whitelist), cada um limitado a AGG_LIMIT_PERCENT.
AGG_TOP_N=5
AGG_MAX_THROTTLES=5
AGG_LIMIT_PERCENT=20

# --- Camada 3: fork bomb (várias cópias idênticas do mesmo comando) ---
FORKBOMB_MIN_COUNT=3
FORKBOMB_SUSTAIN_CHECKS=3

# --- Camada 4: memória ---
# Picos súbitos são tratados pelo earlyoom (/etc/default/earlyoom), que reage
# em ~1s; esta camada roda a cada minuto e cobre vazamento lento e pressão
# sustentada. Valores de RAM em MB, porcentagens sobre o total da máquina.

# 4a. Processo único com RSS >= MEM_PROC_KILL_MB por MEM_PROC_SUSTAIN_CHECKS
#     minutos -> SIGTERM (e SIGKILL na execução seguinte se ignorar).
MEM_PROC_KILL_MB=4096
MEM_PROC_SUSTAIN_CHECKS=3

# 4b. Máquina toda: alerta (Telegram, com cooldown) quando a RAM disponível
#     cai a MEM_AVAIL_WARN_PCT ou o swap passa de MEM_SWAP_USED_WARN_PCT.
MEM_AVAIL_WARN_PCT=20
MEM_SWAP_USED_WARN_PCT=50
MEM_ALERT_COOLDOWN_MIN=30

#     Age quando RAM disponível <= MEM_AVAIL_KILL_PCT E swap livre
#     <= MEM_SWAP_FREE_KILL_PCT por MEM_SYS_SUSTAIN_CHECKS minutos: SIGTERM no
#     maior processo (>= MEM_VICTIM_MIN_MB), priorizando MEM_PREFER_REGEX.
#     Um por vez; o contador zera após cada kill.
MEM_AVAIL_KILL_PCT=10
MEM_SWAP_FREE_KILL_PCT=40
MEM_SYS_SUSTAIN_CHECKS=2
MEM_VICTIM_MIN_MB=200

# Regex ERE contra o comm. Use [.] em vez de \. (vai pro awk via -v).
# Os padrões abaixo miram o que costuma inflar memória numa VPS de
# desenvolvimento: sessões Claude Code, node, php, chrome headless.
# [0-9]+[.][0-9]+[.][0-9]+ = binário versionado do Claude Code (ex.: 2.1.283).
MEM_PREFER_REGEX="^(claude|node|php|php8[.]3|chrome|chrome-devtools|[0-9]+[.][0-9]+[.][0-9]+)$"

# Nunca mortos pela camada de memória. Diferente da WHITELIST_COMM: "claude"
# NÃO está aqui (isento de throttle de CPU, mas pode morrer por memória).
# WHITELIST_CMDLINE também vale aqui.
MEM_WHITELIST_COMM="sshd systemd systemd-journal systemd-logind systemd-udevd systemd-resolve systemd-timesyn systemd-network dbus-daemon cron atop cpulimit cpu-watchdog.sh ps earlyoom dockerd containerd containerd-shim docker-proxy postgres qdrant ollama tailscaled nginx apache2 php-fpm8.3 supervisord s6-supervise fail2ban-server agetty"
