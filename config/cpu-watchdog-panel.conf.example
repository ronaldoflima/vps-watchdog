# cpu-watchdog panel configuration (read at start; restart the panel after edits).
# The panel runs as root and can edit /etc/cpu-watchdog.conf, signal processes,
# restart units and reboot the host. Keep it on loopback and reach it through
# an SSH tunnel: ssh -L 8790:127.0.0.1:8790 <host>
PANEL_BIND=127.0.0.1
PANEL_PORT=8790

# Bearer token required by every /api call. Generated on first start (mode 600).
PANEL_TOKEN_FILE=/etc/cpu-watchdog-panel.token

# Extra Host header values accepted besides 127.0.0.1/localhost/[::1] on PANEL_PORT
# (DNS rebinding protection), e.g. "panel.internal:8790". Space separated.
PANEL_ALLOWED_HOSTS=""

# systemd units the panel may start/stop/restart. Also editable from the panel.
# Prefix a user unit with its owner: "alice/sync.service" runs
# systemctl --user -M alice@ (the user needs lingering: loginctl enable-linger alice).
PANEL_UNITS="cpu-watchdog.timer earlyoom cpu-watchdog-panel"

# 1 = show the reboot action (requires typing the hostname).
PANEL_ALLOW_REBOOT=1

# Sampling interval (seconds) and in-memory history length (minutes).
PANEL_SAMPLE_SEC=3
PANEL_HISTORY_MIN=60

WATCHDOG_CONF=/etc/cpu-watchdog.conf
WATCHDOG_CTL=/usr/local/bin/cpu-watchdog-ctl
EARLYOOM_DEFAULT=/etc/default/earlyoom

# Estimated provider CPU credits (token bucket). Defaults follow Hostinger's
# documented VPS model: earn 60% of the vCPUs per second, a full balance lasts
# 3 h at 100% on every vCPU, at zero the VM is capped at 30% until the balance
# is back to 20%. The provider does not expose the real balance: the panel
# replays recent atop logs on first start, then tracks /proc/stat.
# Calibrate against a limit the provider confirmed: on one KVM 8 a single
# documented limit (cap at 50%) matched BASELINE 55, BURST_HOURS 3.1, THROTTLE 50
# better than the documented defaults. Delete STATE_DIR/panel-credits.json and
# restart the panel to replay history with new values.
PANEL_CREDIT_MODEL=1
PANEL_CREDIT_VCPUS=""
PANEL_CREDIT_BASELINE_PCT=60
PANEL_CREDIT_THROTTLE_PCT=30
PANEL_CREDIT_BURST_HOURS=3
PANEL_CREDIT_RECOVER_PCT=20
PANEL_ATOP_DIR=/var/log/atop
# History replayed on first start; start it after a quiet period (full balance).
PANEL_CREDIT_REPLAY_HOURS=72
